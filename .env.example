# Copy to .env and fill in. Loaded by common/config.py via python-dotenv.
# None of these are secrets except where noted — resource identifiers, not keys.
# Auth is always DefaultAzureCredential (interactive / az cli login from the
# jumpbox), never a client secret in this file.

FLEETOPS_SUBSCRIPTION_ID=
FLEETOPS_RESOURCE_GROUP=rg-fleet-ops-copilot
FLEETOPS_LOCATION=westus

FLEETOPS_FABRIC_CAPACITY_NAME=fleetopsf8
FLEETOPS_WORKSPACE_NAME=fleet-ops-copilot

FLEETOPS_EVENTHOUSE_NAME=fleetops-eventhouse
FLEETOPS_KQL_DATABASE_NAME=fleetops-kql-db
FLEETOPS_TABLE_NAME=BusTelemetry

FLEETOPS_EVENTSTREAM_NAME=fleet-eventstream

FLEETOPS_OPS_AGENT_NAME=Fleet Operations Monitor
FLEETOPS_TEAMS_CHANNEL_WEBHOOK_ID=

FLEETOPS_FOUNDRY_ACCOUNT_NAME=
FLEETOPS_FOUNDRY_PROJECT_NAME=fleet-incident
FLEETOPS_FOUNDRY_AGENT_NAME=Fleet Incident Agent

FLEETOPS_KEY_VAULT_URI=

# state.json path, relative to the repo root unless absolute
FLEETOPS_STATE_FILE=state.json
